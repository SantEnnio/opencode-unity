{
  "name": "opencode-unity",
  "version": "0.2.0",
  "description": "opencode plugin that keeps small/local models honest on Unity projects: compile-on-edit, compiler errors explained with the real Unity API, offline docs, Unity lints, protected files.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "unity",
    "unity3d",
    "csharp",
    "llm",
    "local-llm",
    "guardrails"
  ],
  "author": "Ennio Pirolo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SantEnnio/opencode-unity.git",
    "directory": "packages/opencode-unity"
  },
  "homepage": "https://github.com/SantEnnio/opencode-unity#readme",
  "bugs": "https://github.com/SantEnnio/opencode-unity/issues",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "opencode-unity": "./dist/cli.js"
  },
  "files": [
    "dist",
    "bin",
    "unity-probe",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build:exporter": "dotnet publish ../../tools/symbol-exporter -c Release -o bin/symbol-exporter --nologo -v q",
    "install:global": "bun run scripts/install.ts",
    "uninstall:global": "bun run scripts/install.ts --uninstall",
    "docs:install": "bun run src/cli.ts docs install",
    "prepack": "bun run scripts/prepack.ts",
    "build": "bun run scripts/bundle.ts",
    "test:node": "bun run build && node --no-warnings test/node-smoke.mjs && bun test/node-smoke.mjs"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.31"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
