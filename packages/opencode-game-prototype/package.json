{
  "name": "opencode-game-prototype",
  "version": "0.2.0",
  "description": "opencode plugin that lets small/local models build a quick three.js game prototype: a page that works from the start, a real browser check on every edit, test plays with key presses.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "threejs",
    "webgl",
    "game-prototype",
    "llm",
    "local-llm",
    "guardrails"
  ],
  "author": "Ennio Pirolo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SantEnnio/opencode-unity.git",
    "directory": "packages/opencode-game-prototype"
  },
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "assets",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "assets": "bun run scripts/assets.ts",
    "build": "bun run scripts/bundle.ts",
    "install:global": "bun run scripts/install.ts",
    "uninstall:global": "bun run scripts/install.ts --uninstall",
    "prepack": "bun run scripts/bundle.ts",
    "test:node": "bun run build && node --no-warnings test/node-smoke.mjs && bun test/node-smoke.mjs"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.31"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "three": "0.186.1",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
